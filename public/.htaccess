<IfModule mod_headers.c>
    # Prevent Cloudflare and LiteSpeed from minifying/truncating the CSS file
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "no-transform"
    </FilesMatch>
</IfModule>

<IfModule Litespeed>
    # Disable LiteSpeed Cache and Optimization for this directory
    RewriteEngine On
    RewriteRule .* - [E=Cache-Control:no-cache]
    RewriteRule .* - [E=no-minify:1]
    RewriteRule .* - [E=no-optimize:1]
</IfModule>
